# Salin ke .env lalu ganti nilainya. JANGAN commit file .env.
POSTGRES_DB=musicpedia
POSTGRES_USER=musicpedia
POSTGRES_PASSWORD=ganti-dengan-sandi-db-yang-kuat

# Rahasia penandatangan sesi (minimal 16 karakter). Contoh membuat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-panjang

# Set true hanya bila disajikan lewat HTTPS.
COOKIE_SECURE=false

# Port aplikasi di host (http://localhost:8080)
FRONTEND_PORT=8080
